# Database Configuration (Railway PostgreSQL)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=voting_system
DB_PORT=5432

# JWT Secret Key (Generate a strong random key)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this
SECRET_KEY=your-super-secret-key-change-this

# Flask Environment
FLASK_ENV=development
DEBUG=False

# CORS Origins (Your Netlify frontend URL)
CORS_ORIGINS=http://localhost:5173,https://online-voting-system-mini.netlify.app

# Google OAuth (Get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret-here

# Backend URL (auto-detected on Render via RENDER_EXTERNAL_URL)
# For local development, set to: http://localhost:5000
# For Render production: https://online-voting-3plz.onrender.com
BACKEND_BASE_URL=http://localhost:5000

# Frontend URL (for postMessage origin validation)
# For local: http://localhost:5173
# For production: https://online-voting-system-mini.netlify.app
# Use '*' to allow any origin (development only)
FRONTEND_BASE_URL=*

